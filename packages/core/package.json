{
  "name": "@assetdiet/core",
  "version": "0.1.0",
  "description": "Core types, configuration schema, and shared utilities for AssetDiet MCP",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist .tsbuildinfo",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@assetdiet/typescript-config": "workspace:*",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^5.0.10"
  }
}
