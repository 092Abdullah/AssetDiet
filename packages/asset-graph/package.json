{
  "name": "@assetdiet/asset-graph",
  "version": "0.1.0",
  "description": "Asset graph builder — dedup detection and optimization opportunity ranking",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@assetdiet/core": "workspace:*",
    "@assetdiet/scanner": "workspace:*"
  },
  "devDependencies": {
    "@assetdiet/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^5.0.10"
  }
}
