{
  "name": "@assetdiet/mcp-server",
  "version": "0.1.0",
  "description": "AssetDiet MCP server — exposes AssetDiet capabilities as MCP tools",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "assetdiet-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "clean": "rimraf dist .tsbuildinfo"
  },
  "dependencies": {
    "@assetdiet/core": "workspace:*",
    "@assetdiet/scanner": "workspace:*",
    "@assetdiet/asset-graph": "workspace:*",
    "@assetdiet/planner": "workspace:*",
    "@assetdiet/optimizer-images": "workspace:*",
    "@assetdiet/optimizer-svg": "workspace:*",
    "@assetdiet/optimizer-video": "workspace:*",
    "@assetdiet/optimizer-3d": "workspace:*",
    "@assetdiet/optimizer-fonts": "workspace:*",
    "@assetdiet/reference-analyzer": "workspace:*",
    "@assetdiet/validation": "workspace:*",
    "@assetdiet/transactions": "workspace:*",
    "@assetdiet/reporting": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "sharp": "^0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@assetdiet/typescript-config": "workspace:*",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "rimraf": "^5.0.10"
  }
}
