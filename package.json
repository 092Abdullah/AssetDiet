{
  "name": "assetdiet-mcp",
  "version": "0.1.0",
  "description": "Full-repository asset intelligence and optimization toolkit for AI coding assistants",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "format": "prettier --write \"**/*.{ts,js,json,md}\" --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\" --ignore-path .prettierignore"
  },
  "pnpm": {
    "overrides": {
      "sharp": "0.33.5"
    }
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "rimraf": "^5.0.10",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "mcp",
    "asset-optimization",
    "image-optimization",
    "svg",
    "video",
    "3d",
    "gltf",
    "fonts",
    "cli",
    "ai-agent"
  ],
  "author": "AssetDiet Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/092Abdullah/AssetDiet.git"
  },
  "homepage": "https://github.com/092Abdullah/AssetDiet#readme"
}
